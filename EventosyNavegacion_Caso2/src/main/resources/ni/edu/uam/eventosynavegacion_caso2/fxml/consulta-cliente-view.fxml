<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.eventosynavegacion_caso2.controllers.ConsultaClienteController">
    <children>
        <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="35.0" right="35.0" top="30.0"/>
            </padding>
            <Label text="CONSULTA DE CLIENTES">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Clientes registrados en el sistema">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>
            <TableView fx:id="tvClientes" prefHeight="430.0" prefWidth="830.0" onMouseClicked="#manejarDobleClic">
                <columns>
                    <TableColumn fx:id="colNombreCompleto" prefWidth="220.0" text="Nombre completo"/>
                    <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de cliente"/>
                    <TableColumn fx:id="colCiudad" prefWidth="140.0" text="Ciudad"/>
                    <TableColumn fx:id="colFechaNacimiento" prefWidth="160.0" text="Fecha de nacimiento"/>
                    <TableColumn fx:id="colTipoSolicitud" prefWidth="160.0" text="Tipo de solicitud"/>
                </columns>
                <placeholder>
                    <Label text="No hay clientes registrados"/>
                </placeholder>
            </TableView>
            <Button text="Volver" prefWidth="120.0" onAction="#volverPrincipal"/>
            <Label text="Haz doble clic sobre un cliente para ver sus detalles." style="-fx-text-fill: #666666;"/>
        </VBox>
    </children>
</AnchorPane>