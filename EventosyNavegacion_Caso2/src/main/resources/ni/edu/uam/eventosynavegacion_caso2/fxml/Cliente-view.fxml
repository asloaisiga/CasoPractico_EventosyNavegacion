<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0"
            prefWidth="850.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.eventosynavegacion_caso2.controllers.RegistroClienteController">

    <top>
        <VBox alignment="CENTER" spacing="5.0">
            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <Label text="REGISTRO DE CLIENTE">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <Label text="Ingrese la información solicitada"/>
        </VBox>
    </top>

    <center>

        <HBox alignment="TOP_CENTER" spacing="40.0">

            <padding>
                <Insets top="20.0"
                        right="30.0"
                        bottom="20.0"
                        left="30.0"/>
            </padding>


            <VBox spacing="15.0">

                <Label text="Datos del cliente">
                    <font>
                        <Font name="System Bold" size="17.0"/>
                    </font>
                </Label>

                <Separator prefWidth="500.0"/>

                <GridPane hgap="15.0"
                          vgap="15.0">

                    <Label text="Nombres:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="txtNombres"
                               promptText="Ingrese los nombres"
                               prefWidth="280.0"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Apellidos:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <TextField fx:id="txtApellidos"
                               promptText="Ingrese los apellidos"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Tipo de cliente:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <ComboBox fx:id="cbTipoCliente"
                              promptText="Seleccione"
                              prefWidth="280.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2"/>

                    <Label text="Ciudad:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <ComboBox fx:id="cbCiudad"
                              promptText="Seleccione"
                              prefWidth="280.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3"/>

                    <Label text="Fecha de nacimiento:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <DatePicker fx:id="dpFechaNacimiento"
                                prefWidth="280.0"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="4"/>

                </GridPane>



                <Label text="Tipo de solicitud:">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>

                <fx:define>
                    <ToggleGroup fx:id="grupoSolicitud"/>
                </fx:define>

                <HBox spacing="15.0">

                    <RadioButton fx:id="rbInformacion"
                                 text="Información"
                                 toggleGroup="$grupoSolicitud"/>

                    <RadioButton fx:id="rbCotizacion"
                                 text="Cotización"
                                 toggleGroup="$grupoSolicitud"/>

                    <RadioButton fx:id="rbReclamo"
                                 text="Reclamo"
                                 toggleGroup="$grupoSolicitud"/>

                </HBox>


                <Label text="Servicios de interés:">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>

                <HBox spacing="15.0">

                    <CheckBox fx:id="chkInternet"
                              text="Internet"/>

                    <CheckBox fx:id="chkSoporte"
                              text="Soporte técnico"/>

                    <CheckBox fx:id="chkMantenimiento"
                              text="Mantenimiento"/>

                </HBox>

            </VBox>


            <VBox alignment="TOP_CENTER"
                  spacing="15.0">

                <Label text="Fotografía">
                    <font>
                        <Font name="System Bold" size="17.0"/>
                    </font>
                </Label>

                <ImageView fx:id="imgFotografia"
                           fitHeight="200.0"
                           fitWidth="180.0"
                           preserveRatio="true"/>

                <Button fx:id="btnSeleccionarFotografia"
                        text="Seleccionar fotografía"
                        prefWidth="180.0"
                        onAction="#seleccionarFotografia"/>

                <Label fx:id="lblRutaFotografia"
                       text="Sin fotografía"
                       wrapText="true"
                       maxWidth="180.0"/>

            </VBox>

        </HBox>

    </center>


    <bottom>

        <HBox alignment="CENTER"
              spacing="20.0">

            <padding>
                <Insets top="15.0"
                        right="20.0"
                        bottom="25.0"
                        left="20.0"/>
            </padding>

            <Button fx:id="btnGuardar"
                    text="Guardar"
                    prefHeight="40.0"
                    prefWidth="130.0"
                    onAction="#guardarCliente"/>

            <Button fx:id="btnLimpiar"
                    text="Limpiar"
                    prefHeight="40.0"
                    prefWidth="130.0"
                    onAction="#limpiarFormulario"/>

            <Button fx:id="btnCancelar"
                    text="Cancelar"
                    prefHeight="40.0"
                    prefWidth="130.0"
                    onAction="#cancelar"/>

        </HBox>

    </bottom>

</BorderPane>